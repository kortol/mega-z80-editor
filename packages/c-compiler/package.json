{
  "name": "@mz80/c-compiler",
  "version": "0.1.0",
  "license": "MIT",
  "description": "SCC TypeScript C compiler for MZ80.",
  "repository": { "type": "git", "url": "https://github.com/kortol/mega-z80-editor.git", "directory": "packages/c-compiler" },
  "engines": { "node": ">=18" },
  "files": ["dist/**/*", "README.md", "docs/**/*"],
  "publishConfig": { "access": "public" },
  "exports": { ".": { "types": "./dist/index.d.ts", "require": "./dist/index.js" } },
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "scripts": { "build": "pnpm exec tsc -p tsconfig.build.json && node tools/copy-runtime.js && node tools/build-runtime-artifacts.js", "typecheck": "pnpm exec tsc --noEmit -p tsconfig.json", "test": "jest --config jest.config.cjs --runInBand", "test:msx-runtime": "node tools/run-msx-runtime-smoke.cjs", "prepack": "pnpm run build" },
  "dependencies": { "@mz80/assembler": "workspace:*", "@mz80/core": "workspace:*", "pino": "^10.1.0" },
  "devDependencies": { "@types/jest": "^30.0.0", "@types/node": "^24.5.2", "jest": "^30.1.3", "ts-jest": "^29.4.4", "typescript": "^5.6.3" }
}
